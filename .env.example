# MASA Framework Environment Configuration
# Copy this file to .env.local for local development
# NEVER commit .env.local or .env to version control!

# =============================================================================
# MASA CORE CONFIGURATION
# =============================================================================

# Master encryption key - MUST BE CHANGED FOR PRODUCTION
# Generated via: python3 -c "import secrets; print(secrets.token_hex(32))"
MASA_MASTER_KEY=your-16-character-master-key-here

# Framework home directory (default: ~/.masa)
MASA_HOME_DIR=/home/nesmark/.masa

# User config path (default: ~/.masa_user_config.json)
MASA_USER_CONFIG_PATH=/home/nesmark/.masa_user_config.json

# =============================================================================
# MODEL SUBSCRIPTIONS (Optional - use local models for privacy)
# =============================================================================

# Antigravity CLI subscription token
# AGY_API_TOKEN=your-agy-subscription-token

# Claude Code API key
# CLAUDE_API_KEY=your-claude-api-key

# GitHub Copilot / Codex token
# CODEX_API_TOKEN=your-copilot-api-token

# =============================================================================
# LOCAL AI MODELS (Optional - recommended for privacy)
# =============================================================================

# Local model endpoint (default: localhost:1234)
# Set to empty string if not using local models
LOCAL_MODEL_URL=http://localhost:1234

# Local model name
LOCAL_MODEL_NAME=qwen2.5-coder-7b

# =============================================================================
# REDIS BROKER (Optional - for distributed task queue)
# =============================================================================

# Backend URL for Redis task broker (optional, defaults to local queue)
# Format: redis://user:password@host:port/db
MASA_REDIS_BACKEND=

# =============================================================================
# SECURITY & LOGGING
# =============================================================================

# Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose logging for debugging (default: false)
DEBUG=false

# Log file path (if not stdout/stderr)
LOG_FILE_PATH=/var/log/masa/orchestrator.log

# =============================================================================
# SYSTEM LIMITS (Windows-specific via install.sh)
# =============================================================================

# Max CPU percentage per agent (0-100, default: 50)
AGENT_CPU_LIMIT_PERCENT=50

# Max memory in MB per agent (default: 2048)
AGENT_MEMORY_LIMIT_MB=2048

# =============================================================================
# SECURITY WARNINGS - REVIEW BEFORE PRODUCTION DEPLOYMENT
# =============================================================================
# ⚠️ NEVER commit the following to version control!
# ⚠️ Rotate these regularly and use secrets management in production:
# - MASA_MASTER_KEY
# - AGY_API_TOKEN (if used)
# - CLAUDE_API_KEY (if used)
# - CODEX_API_TOKEN (if used)
